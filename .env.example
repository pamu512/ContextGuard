# Gemini Developer API (free tier)
GOOGLE_API_KEY=

# DataHub Cloud MCP endpoint, e.g. https://<tenant>.acryl.io/integrations/ai/mcp
DATAHUB_MCP_URL=

# DataHub personal access token (Bearer)
DATAHUB_TOKEN=

# Optional: allow writing review docs/tags back to DataHub (default false)
CONTEXTGUARD_ALLOW_WRITEBACK=false
